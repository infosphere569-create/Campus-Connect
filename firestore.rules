rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roleIs(r) {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == r;
    }

    function staff() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        in ['moderator', 'platformAdmin'];
    }

    function admin() {
      return roleIs('platformAdmin');
    }

    match /users/{uid} {
      allow read: if self(uid) || staff();
      allow create: if self(uid);
      allow update: if self(uid) || admin();
      allow delete: if admin();
    }

    match /posts/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.authorUid == request.auth.uid || staff());
    }

    match /comments/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.authorUid == request.auth.uid || staff());
    }

    match /groups/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.createdBy == request.auth.uid || staff());
    }

    match /groupMembers/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || staff());
    }

    match /groupRequests/{id} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || staff());
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || staff());
    }

    match /issues/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
        (staff() ||
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['supportCount', 'updatedAt']));
      allow delete: if staff();
    }

    match /issuePrivate/{id} {
      allow read: if staff();
      allow write: if false;
    }

    match /reports/{id} {
      allow create: if signedIn() &&
        request.resource.data.reporterId == request.auth.uid;
      allow read: if staff();
      allow update: if staff();
      allow delete: if admin();
    }

    match /auditLogs/{id} {
      allow read: if staff();
      allow create: if staff();
      allow update, delete: if admin();
    }

    match /notifications/{id} {
      allow read: if signedIn() &&
        resource.data.uid == request.auth.uid;
      allow create: if staff();
      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['read']);
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /postLikes/{postId}/users/{uid} {
      allow read: if signedIn();
      allow create, delete: if self(uid);
    }

    match /savedPosts/{uid}/items/{postId} {
      allow read, write: if self(uid);
    }

    match /issueVotes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() &&
        resource.data.uid == request.auth.uid;
    }

    match /events/{id} {
      // This collection had NO rule at all before -- Firestore denies everything
      // by default when nothing matches, so every read and write to events
      // (including admin creating one, and students tapping "Interested") was
      // silently rejected. Staff manage events; any signed-in user may only
      // touch the interestedCount field (the RSVP counter).
      allow read: if signedIn();
      allow create, delete: if staff();
      allow update: if staff() ||
        (signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedCount']));
    }

    match /eventInterest/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
    }
  }
}
