rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
function signedIn(){return request.auth!=null;} function image(){return request.resource!=null&&request.resource.contentType.matches('image/.*');}
match /users/{uid}/{allPaths=**}{allow read:if signedIn();allow write:if signedIn()&&request.auth.uid==uid&&image()&&request.resource.size<5*1024*1024;}
match /posts/{uid}/{allPaths=**}{allow read:if signedIn();allow write:if signedIn()&&request.auth.uid==uid&&image()&&request.resource.size<10*1024*1024;}
match /groups/{uid}/{allPaths=**}{allow read:if signedIn();allow write:if signedIn()&&request.auth.uid==uid&&image()&&request.resource.size<10*1024*1024;}
match /events/{uid}/{allPaths=**}{allow read:if signedIn();allow write:if signedIn()&&request.auth.uid==uid&&image()&&request.resource.size<10*1024*1024;}
}}
